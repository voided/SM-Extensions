import os, sys
import re

builder.SetBuildFolder('/')

includes = builder.AddFolder('includes')

argv = [
  sys.executable,
  os.path.join(builder.sourcePath, 'tools', 'generate_headers.py'),
  os.path.join(builder.sourcePath),
  os.path.join(builder.buildPath, 'includes'),
]

outputs = [
  os.path.join(builder.buildFolder, 'includes', 'sourcemod_version_auto.h'),
  os.path.join(builder.buildFolder, 'includes', 'git_action_release'),
]

# The extension is vendored below the repository root. Resolve the Git paths
# through Git rather than assuming a .git directory next to product.version.
import subprocess

def git_path(name):
  # Git 2.30 (Debian 11) does not support --path-format. Resolve relative
  # paths from the directory passed to Git, including in linked worktrees.
  path = subprocess.check_output(['git', '-C', builder.sourcePath, 'rev-parse',
                                  '--git-path', name], text=True).strip()
  return os.path.abspath(os.path.join(builder.sourcePath, path))

git_head_path = git_path('HEAD')
with open(git_head_path) as fp:
  head_contents = fp.read().strip()
if head_contents.startswith('ref: '):
  ref_path = git_path(head_contents[5:])
  if os.path.exists(ref_path):
    git_head_path = ref_path

sources = [
  os.path.join(builder.sourcePath, 'product.version'),

  # This is a hack, but we need some way to only run this script when Git changes.
  git_head_path,

  # The script source is a dependency, of course...
  argv[1]
]

output_nodes = builder.AddCommand(
  inputs=sources,
  argv=argv,
  outputs=outputs
)

rvalue = output_nodes
