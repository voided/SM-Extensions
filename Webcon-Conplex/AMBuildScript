import os
import sys
from pathlib import Path

root = Path(builder.sourcePath)
sm = Path(builder.options.sm_path).resolve()
component = builder.options.component
targets = [builder.DetectCxx(target_arch=arch) for arch in builder.options.targets.split(',')]

for cxx in targets:
    if cxx.like('gcc'):
        cxx.defines += ['HAVE_STDINT_H', '_LINUX']
        cxx.cflags += ['-pipe', '-fPIC', '-fno-strict-aliasing', '-fvisibility=hidden']
        cxx.cxxflags += ['-std=c++17', '-fvisibility-inlines-hidden']
        cxx.linkflags += ['-static-libgcc', '-static-libstdc++']
        if builder.options.debug:
            cxx.cflags += ['-g']
        if builder.options.opt:
            cxx.cflags += ['-O3']
    elif cxx.like('msvc'):
        cxx.defines += ['WIN32', '_CRT_SECURE_NO_WARNINGS', '_CRT_NONSTDC_NO_WARNINGS', '_ITERATOR_DEBUG_LEVEL=0']
        cxx.cflags += ['/W3', '/MTd' if builder.options.debug else '/MT']
        cxx.cxxflags += ['/EHsc', '/std:c++17']
        if builder.options.debug:
            cxx.cflags += ['/Zi']
            cxx.linkflags += ['/DEBUG']
        if builder.options.opt:
            cxx.cflags += ['/Ox']
    cxx.defines += ['DEBUG', '_DEBUG'] if builder.options.debug else ['NDEBUG']

safetyhook_tasks = []
if component == 'conplex':
    if not builder.options.hl2sdk_root:
        raise ValueError('--hl2sdk-root is required for Conplex')
    sdk_root = Path(builder.options.hl2sdk_root).resolve()
    helpers = builder.Eval(str(sm / 'hl2sdk-manifests/SdkHelpers.ambuild'), {'Project': 'sm-extension'})
    helpers.find_sdk_path = lambda name: str(sdk_root / ('hl2sdk-' + name))
    helpers.findSdks(builder, targets, ['tf2'])
    sdk = helpers.sdks['tf2']
    support = root.parent / 'build-support'
    builder.AddConfigureFile(str(support / 'safetyhook.py'))
    sys.path.insert(0, str(support))
    from safetyhook import build_safetyhook
    safetyhook_include, safetyhook_tasks = build_safetyhook(builder, targets)

project = builder.LibraryProject(component + '.ext')
project.sources += [str(root / component / 'extension.cpp'), str(sm / 'public/smsdk_ext.cpp')]
for cxx in targets:
    binary = project.Configure(cxx, component + '.ext', cxx.target.arch)
    compiler = binary.compiler
    compiler.defines += ['SOURCEMOD_BUILD']
    compiler.cxxincludes += [str(p) for p in (
        root / component, root / 'conplex/public',
        sm / 'public', sm / 'public/extensions', sm / 'public/amtl',
        sm / 'public/amtl/amtl', sm / 'sourcepawn/include',
    )]
    if component == 'conplex':
        compiler.defines += ['SE_{}={}'.format(item['define'], item['code']) for item in helpers.sdk_manifests]
        helpers.configureCxx(builder, binary, sdk)
        compiler.cxxincludes += [safetyhook_include]
        compiler.linkflags += [next(task.binary for task in safetyhook_tasks if task.target.arch == cxx.target.arch)]
    else:
        if not builder.options.microhttpd_root:
            raise ValueError('--microhttpd-root is required for Webcon')
        prefix = Path(builder.options.microhttpd_root).resolve() / cxx.target.arch
        archive = prefix / 'lib' / ('libmicrohttpd.lib' if cxx.target.platform == 'windows' else 'libmicrohttpd.a')
        if not archive.is_file():
            raise FileNotFoundError(f'No static libmicrohttpd at {archive}')
        compiler.cxxincludes += [str(prefix / 'include')]
        compiler.postlink += [str(archive)]
        if cxx.target.platform == 'windows':
            compiler.defines += ['MHD_W32LIB']
        else:
            compiler.linkflags += ['-pthread']
    if cxx.target.platform == 'windows':
        compiler.linkflags += ['ws2_32.lib']

binaries = builder.Add(project)
builder.SetBuildFolder('package')
files = {'scripting/include': [f'{component}/{component}.inc']}
if component == 'conplex':
    files['gamedata'] = ['conplex/conplex.games.txt']
else:
    files['scripting'] = ['webcon/webcon.sp', 'samples/scoreboard/webscoreboard.sp',
                         'samples/manager/webmanager.sp', 'samples/irc/irc.sp']
    files['configs/web/scoreboard'] = ['samples/scoreboard/index.html', 'samples/scoreboard/background.jpg',
                                      'samples/scoreboard/classes.png', 'samples/scoreboard/tf2.ttf']
for folder, paths in files.items():
    output = builder.AddFolder(os.path.join('addons/sourcemod', folder))
    for path in paths:
        builder.AddCopy(str(root / path), output)
for binary in binaries:
    folder = 'addons/sourcemod/extensions' + ('/x64' if binary.target.arch == 'x86_64' else '')
    builder.AddCopy(binary.binary, builder.AddFolder(folder))
